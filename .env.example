# Copy to .env and fill in. `.env` is not committed (see .gitignore).

# Any long random value; must match the api_key in every Hermes profile.
#   PowerShell: "sk-" + [guid]::NewGuid().ToString("N")
LITELLM_MASTER_KEY=

# Tailnet address of each node, from `tailscale ip -4` on that machine.
# MagicDNS names work too if it is enabled: NODE_A_IP=node-a.tailnet-name.ts.net
NODE_A_IP=      # architect   - llama3.1:8b
NODE_B_IP=      # techlead    - llama3.1:8b
NODE_C_IP=      # coder       - qwen2.5-coder:14b  (+ worker pool)
NODE_D_IP=      # tester      - qwen2.5-coder:14b  (+ worker pool)
NODE_E_IP=      # docs        - llama3.1:8b
NODE_F_IP=      # deployer    - qwen2.5-coder:14b  (+ worker pool)
