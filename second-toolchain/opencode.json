{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": "deny"
  },
  "provider": {
    "node-a": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Node A",
      "options": {
        "baseURL": "{env:NODE_A_BASE_URL}",
        "apiKey": "{env:NODE_A_API_KEY}"
      },
      "models": {}
    },
    "node-b": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Node B",
      "options": {
        "baseURL": "{env:NODE_B_BASE_URL}",
        "apiKey": "{env:NODE_B_API_KEY}"
      },
      "models": {}
    }
  }
}
