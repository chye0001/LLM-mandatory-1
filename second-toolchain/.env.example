# Copy to .env and fill in. docker-compose injects this into the container with
# env_file, and opencode.json then reads it through {env:...}.

# Language toolchain installed into the sandbox image, passed to the Dockerfile
# as a build argument. Change it and rebuild to target another language:
#   LANG_PACKAGES="go"   or   LANG_PACKAGES="openjdk21 maven"
LANG_PACKAGES="nodejs npm python3"

# Six nodes, node-a through node-f. Each one needs three values.
#
# NODE_*_HOST     Address and port of the model server. The addresses below are
#                 examples. Replace them with the real ones, for a tailnet from
#                 `tailscale ip -4` on each machine. Use port 11434 for ollama
#                 and 8080 for llama.cpp. opencode.json wraps the value as
#                 http://<host>/v1, so do not add a scheme or a path here.
#
# NODE_*_API_KEY  Leave empty for a server started without auth. That is always
#                 the case for ollama, and for llama.cpp unless it was started
#                 with --api-key.
#
# NODE_*_MODEL    The model ID that node serves, copied exactly as the server
#                 reports it. For ollama that is the tag from `ollama list`.
#                 For llama.cpp it is the --alias, otherwise the .gguf filename.
#
# Which role runs on which node is set in the agent block of opencode.json, not
# here. Fewer than six machines is fine, just point several NODE_*_HOST values
# at the same address. See "Running on fewer machines" in the README.
#
# Fill in all six. A blank host resolves to http:///v1 and a blank model
# registers an empty name, and neither one reports an error at startup.

NODE_A_HOST=100.64.0.1:11434
NODE_A_API_KEY=
NODE_A_MODEL=CHANGEME

NODE_B_HOST=100.64.0.2:11434
NODE_B_API_KEY=
NODE_B_MODEL=CHANGEME

NODE_C_HOST=100.64.0.3:11434
NODE_C_API_KEY=
NODE_C_MODEL=CHANGEME

NODE_D_HOST=100.64.0.4:11434
NODE_D_API_KEY=
NODE_D_MODEL=CHANGEME

NODE_E_HOST=100.64.0.5:11434
NODE_E_API_KEY=
NODE_E_MODEL=CHANGEME

NODE_F_HOST=100.64.0.6:11434
NODE_F_API_KEY=
NODE_F_MODEL=CHANGEME
