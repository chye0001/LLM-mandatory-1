# Copy to .env and fill in. Injected into the container by docker-compose (env_file),
# then read by opencode.json via {env:...}.
#
# Six nodes, matching ../first-toolchain. Addresses are the raw tailnet IP from
# `tailscale ip -4` on that machine, plus the port:
#   ollama    -> 11434
#   llama.cpp -> 8080
# opencode.json wraps each as http://<host>/v1 — do not add a scheme or path here.
#
# API keys stay empty for a server started without auth (ollama always; llama.cpp
# unless started with --api-key).
#
# Fewer than six machines? Point the spare NODE_*_HOST vars at a machine you do
# have — see "Running on fewer machines" in the README. Every one of the six must
# be set to something reachable; a blank resolves to http:///v1 and fails silently.

# node-a  ->  architect           llama3.1:8b
NODE_A_HOST=100.64.0.1:11434
NODE_A_API_KEY=
NODE_A_MODEL=llama3.1:8b

# node-b  ->  techlead            llama3.1:8b
NODE_B_HOST=100.64.0.2:11434
NODE_B_API_KEY=
NODE_B_MODEL=llama3.1:8b

# node-c  ->  coder-a             qwen2.5-coder:14b
NODE_C_HOST=100.64.0.3:11434
NODE_C_API_KEY=
NODE_C_MODEL=qwen2.5-coder:14b

# node-d  ->  tester              qwen2.5-coder:14b
NODE_D_HOST=100.64.0.4:11434
NODE_D_API_KEY=
NODE_D_MODEL=qwen2.5-coder:14b

# node-e  ->  docwriter           llama3.1:8b
NODE_E_HOST=100.64.0.5:11434
NODE_E_API_KEY=
NODE_E_MODEL=llama3.1:8b

# node-f  ->  coder-b, deployer   qwen2.5-coder:14b
NODE_F_HOST=100.64.0.6:11434
NODE_F_API_KEY=
NODE_F_MODEL=qwen2.5-coder:14b
